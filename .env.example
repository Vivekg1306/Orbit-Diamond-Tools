# ──────────────────────────────────────────────
# Orbit Diamond Tools — Environment Variables
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# ── Public ────────────────────────────────────
# Production URL (used for sitemap, OG images, canonical links)
NEXT_PUBLIC_SITE_URL=https://orbitdiamondtools.com

# ── SMTP (required for /api/enquiry) ──────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# ── Email Routing ─────────────────────────────
# Who receives enquiry emails (defaults to pg02029845@gmail.com)
ENQUIRY_TO=sales@orbitdiamondtools.com
# "From" address (defaults to SMTP_USER)
SMTP_FROM=noreply@orbitdiamondtools.com
